# Space-Track 账号配置
SPACETRACK_USER=your_email@example.com
SPACETRACK_PASS=your_password

# Telegram Bot 凭据（新对象发现推送通知）
# 通过 @BotFather 创建 Bot 获取 token，chat_id 为接收通知的个人或群组 ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Cesium Ion Access Token（可选）
# 不提供则自动使用 OpenStreetMap 免费瓦片作为底图
# 注册免费 token：https://ion.cesium.com/signup
CESIUM_ION_TOKEN=your_cesium_ion_token_here

#代理
HTTPS_PROXY=http://host:port
HTTP_PROXY=http://host:port

# 日志级别（默认 INFO）
# 可选值: INFO, DEBUG, WARNING, ERROR
# LOG_LEVEL=INFO
# 按模块覆盖: 
# LOG_LEVEL_xpropagator_client=DEBUG